# HunarSetu settings. Copy this file to .env. Everything is optional.

# ---- AI counsellor -------------------------------------------------------
# With no keys at all, HunarSetu uses Pollinations, a free AI service that needs no key.
# For faster, more reliable answers, add a FREE key from one of these:
#   Groq:   https://console.groq.com/keys          (free tier)
#   Gemini: https://aistudio.google.com/apikey     (free tier)
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional paid option: Claude (Anthropic). Used first when set.
ANTHROPIC_API_KEY=

# Force one provider: claude | groq | gemini | pollinations | offline
# LLM_PROVIDER=
# Stop sending family messages to the keyless free service (Pollinations):
# HUNARSETU_FREE_AI=off
# Model overrides:
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
# POLLINATIONS_MODEL=openai
# HUNARSETU_MODEL=claude-opus-5-5

# ---- Officials' dashboard ------------------------------------------------
# The Admin dashboard and call-back list need this password. Without it they stay locked.
# Use quotes if the password contains # (otherwise everything after # is ignored).
ADMIN_PASSWORD=

# ---- Server ----------------------------------------------------------------
# PORT=8080
